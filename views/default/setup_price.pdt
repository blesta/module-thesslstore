<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('thesslstore_apply_margin').addEventListener('change', function() {
            document.getElementById('thesslstore_margin_percentage').disabled = !this.checked;
        });

        //alert box on margin textbox
        document.querySelector('label.thesslstore_margin_percentage').addEventListener('click', function() {
            if (document.getElementById('thesslstore_margin_percentage').disabled) {
                alert("Please check the Apply Profit Margin checkbox first");
            }
        });

        //confirm button on save button
        document.querySelector('a.save_price').addEventListener('click', function() {
            return window.confirm("Do you really want to the update price?");
        });
    });
</script>
