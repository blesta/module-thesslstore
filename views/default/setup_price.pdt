        }
        $this->Form->label(
            $this->_('ThesslstoreModule.setup_price.margin_percentage', true),
            'thesslstore_margin_percentage',
            ['class' => 'thesslstore_margin_percentage'],
        );
        $this->Form->fieldText(
            'thesslstore_margin_percentage',
